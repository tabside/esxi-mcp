ESXI_HOST=esxi.example.com
ESXI_PORT=443
# Eigener ESXi-User mit eigener Rolle, nie root
ESXI_USER=mcp
ESXI_PASSWORD=
# true | false | Pfad zu CA-Datei (ESXi nutzt oft ein selbstsigniertes Zertifikat)
ESXI_VERIFY_SSL=true
# optional, nur falls der Container den Host über einen HTTP-Proxy erreichen muss (host:port)
ESXI_HTTP_PROXY=
# langes zufälliges Bearer-Token für den MCP-Endpoint (mind. 24 Zeichen)
MCP_AUTH_TOKEN=
# true sperrt alle schreibenden Tools
MCP_READONLY=false
# true erlaubt vm_snapshot_remove (einzelne Snapshots löschen, zusätzlich confirm pro Aufruf)
MCP_ALLOW_DELETE=false
# kommagetrennte VM-Namen oder MoIDs, die per MCP nicht verändert werden dürfen
MCP_PROTECTED_VMS=
# optionale Obergrenzen für vm_set_resources
MCP_MAX_MEMORY_MB=
MCP_MAX_CPU=
# optional
MCP_BIND_ADDR=0.0.0.0
MCP_HOST_PORT=8431
